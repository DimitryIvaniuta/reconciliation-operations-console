map $http_sec_fetch_site $cross_site_request {
  default 0;
  cross-site 1;
}

map $request_method $api_method_allowed {
  default 0;
  GET 1;
  POST 1;
}

map "$request_method:$http_content_type" $api_content_type_allowed {
  default 0;
  ~^GET: 1;
  "~^POST:application/json(?:;.*)?$" 1;
}

map $http_x_correlation_id $upstream_correlation_id {
  default $request_id;
  "~^[0-9A-Fa-f-]{36}$" $http_x_correlation_id;
}

server {
  listen 8080;
  server_name _;
  root /usr/share/nginx/html;
  index index.html;
  server_tokens off;
  client_max_body_size 128k;
  client_body_timeout 10s;
  send_timeout 35s;
  keepalive_timeout 15s;

  include /etc/nginx/snippets/security-headers.conf;

  location = /healthz {
    access_log off;
    default_type text/plain;
    add_header Cache-Control "no-store" always;
    return 200 'ok';
  }

  location = /config.js {
    alias /var/run/ledgerguard/config.js;
    default_type application/javascript;
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store, max-age=0" always;
  }

  location /assets/ {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "public, max-age=31536000, immutable" always;
    try_files $uri =404;
  }

  location /api/ {
    if ($cross_site_request) { return 403; }
    if ($api_method_allowed = 0) { return 405; }
    if ($api_content_type_allowed = 0) { return 415; }

    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    proxy_pass ${BACKEND_API_URL}/api/;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header X-API-Key "${BACKEND_API_KEY}";
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;
    proxy_set_header X-Correlation-ID $upstream_correlation_id;
    proxy_connect_timeout 5s;
    proxy_read_timeout 35s;
    proxy_send_timeout 35s;
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Set-Cookie;
  }

  location = /actuator/health {
    if ($request_method != GET) { return 405; }
    if ($cross_site_request) { return 403; }

    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    proxy_pass ${BACKEND_API_URL}/actuator/health;
    proxy_http_version 1.1;
    proxy_set_header Host $proxy_host;
    proxy_set_header Authorization "";
    proxy_set_header Cookie "";
    proxy_set_header Connection "";
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 10s;
    proxy_hide_header Server;
    proxy_hide_header X-Powered-By;
    proxy_hide_header Set-Cookie;
  }

  location ^~ /actuator/ {
    return 404;
  }

  location / {
    include /etc/nginx/snippets/security-headers.conf;
    add_header Cache-Control "no-store" always;
    try_files $uri $uri/ /index.html;
  }
}
